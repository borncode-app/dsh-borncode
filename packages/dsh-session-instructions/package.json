{
    "name":  "@local/dsh-session-instructions",
    "version":  "1.0.0",
    "private":  true,
    "type":  "module",
    "description":  "Reads the user\u0027s standing instructions before any work starts, so the deliverables that must not be forgotten travel with every request.",
    "author":  "BornCode (https://github.com/borncode-app)",
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/borncode-app/dsh-borncode.git"
                   },
    "homepage":  "https://github.com/borncode-app/dsh-borncode#readme",
    "bugs":  {
                 "url":  "https://github.com/borncode-app/dsh-borncode/issues"
             },
    "keywords":  [
                     "dsh",
                     "deepseek-harness",
                     "dsh-plugin",
                     "instructions",
                     "system-prompt",
                     "settings",
                     "deliverables"
                 ],
    "exports":  {
                    ".":  "./index.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "files":  [
                  "index.js",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "icon.svg"
              ],
    "dependencies":  {
                         "@deepseek-ai/schemastery":  "~3.19.0"
                     },
