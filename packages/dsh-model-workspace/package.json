{
  "name": "@local/dsh-model-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Adds a Model workspace shortcut to the sidebar's More menu that opens Our Free Model's workspace page.",
  "author": "BornCode (https://github.com/borncode-app)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/borncode-app/dsh-borncode.git"
  },
  "homepage": "https://github.com/borncode-app/dsh-borncode#readme",
  "bugs": {
    "url": "https://github.com/borncode-app/dsh-borncode/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "sidebar",
    "shortcut",
    "our-free-model",
    "magpie"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
