{
    "name":  "@local/dsh-borncode",
    "version":  "1.0.0",
    "private":  true,
    "type":  "module",
    "description":  "Installs the BornCode plugins as one Plugins entry: agent customization, native desktop control, auto-continue, auto-shutdown, browser use, session instructions, session sync, and the side chat.",
    "author":  "BornCode (https://github.com/borncode-app)",
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/borncode-app/dsh-borncode.git"
                   },
    "homepage":  "https://github.com/borncode-app/dsh-borncode#readme",
    "bugs":  {
                 "url":  "https://github.com/borncode-app/dsh-borncode/issues"
             },
    "keywords":  [
                     "dsh",
                     "deepseek-harness",
                     "dsh-plugin",
                     "borncode",
                     "kit"
                 ],
    "exports":  {
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "files":  [
                  "cordis.patch.yml",
                  "locale/*.json",
                  "docs",
                  "icon.svg",
                  "README.md",
                  "packages"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "dependencies":  {
                         "@local/dsh-agent-customizer":  "link:./packages/dsh-agent-customizer",
                         "@local/dsh-agent-desktop":  "link:./packages/dsh-agent-desktop",
                         "@local/dsh-auto-continue":  "link:./packages/dsh-auto-continue",
                         "@local/dsh-auto-shutdown":  "link:./packages/dsh-auto-shutdown",
                         "@local/dsh-browser-use":  "link:./packages/dsh-browser-use",
                         "@local/dsh-session-instructions":  "link:./packages/dsh-session-instructions",
                         "@local/dsh-session-sync":  "link:./packages/dsh-session-sync",
                         "@local/dsh-side-chat":  "link:./packages/dsh-side-chat",
                         "@local/dsh-minimax-auth":  "link:./packages/dsh-minimax-auth",
                         "@local/dsh-minimax-bridge":  "link:./packages/dsh-minimax-bridge",
                         "@local/dsh-minimax-checkin":  "link:./packages/dsh-minimax-checkin",
                         "@local/dsh-minimax-credit":  "link:./packages/dsh-minimax-credit",
                         "@local/dsh-minimax-model-sync":  "link:./packages/dsh-minimax-model-sync",
                         "@local/dsh-minimax-web-search":  "link:./packages/dsh-minimax-web-search",
                         "@local/dsh-model-quota":  "link:./packages/dsh-model-quota"
                     }
}
